  "scales": {
    "spacing": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "24px",
      "space-6": "32px",
      "space-7": "48px"
    },
    "layout": {
      "gutter": "16px",
      "gutter-wide": "40px",
      "content-max": "1440px",
      "target-min": "44px"
    },
    "type scale": {
      "font-size-xs": "12px",
      "font-size-sm": "13px",
      "font-size-base": "15px",
