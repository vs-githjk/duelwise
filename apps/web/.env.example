# Required in production. No values here; set them in the host's environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to enable the dev login (never in production).
DEV_LOGIN=
# Friend links (M5). The same secret goes on the relay Worker. Server only; never prefix it with VITE_.
DUEL_SIGNING_SECRET=
# Production relay: wss://duelwise-relay.duelwise-duel-relay.workers.dev (set it in the host's environment; not set by this task).
# The relay's address as the browser sees it, for example wss://duelwise-relay.<account>.workers.dev. Empty in a build turns friend links off.
VITE_DUEL_RELAY_URL=
