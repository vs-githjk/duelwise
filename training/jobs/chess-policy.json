{
  "name": "chess-policy",
  "cmd": ["scripts/py", "-m", "trainer.chess.train_policy", "--max-minutes", "25"],
  "cpuSlots": 0,
  "mps": true,
  "maxHours": 2,
  "after": ["chess-data"],
