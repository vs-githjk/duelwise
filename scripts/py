#!/usr/bin/env bash
# Run Python with the shared training venv if present, else the system Python.
# PYTHONPATH always points at THIS worktree's training/ so a lane never imports another worktree's trainer.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE="$(cd "$HERE/.." && pwd)"
COMMON_GIT="$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)"
COMMON_ROOT="$(cd "$COMMON_GIT/.." && pwd)"
VENV_PY="$COMMON_ROOT/training/.venv/bin/python"
SYSTEM_PY="/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"
if [ -x "$VENV_PY" ]; then PY="$VENV_PY"; else PY="$SYSTEM_PY"; fi
export PYTHONPATH="$WORKTREE/training${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$@"
