# Duelwise environment variables. Names and comments only: copy to .env (never committed) and fill in
# the values yourself. Nothing in this file is a secret, and nothing here may ever hold a value.
# Step by step setup for Vercel, Neon and the sign-in providers: docs/deploy.md.
#
# Local development needs none of these. Without DATABASE_URL the app uses a PGlite database in
# <common root>/.data/pglite, and with DEV_LOGIN=1 a dev-only sign-in appears.

# ---- Production (set these in the Vercel project, Production environment) ----

# Neon pooled connection string (the host contains "-pooler"). When set, the app uses Neon; when empty it uses PGlite.
DATABASE_URL=

# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin of the site with no trailing slash, for example https://your-site.vercel.app.
# OAuth callbacks are <this>/api/auth/callback/google and <this>/api/auth/callback/github.
BETTER_AUTH_URL=

# Google sign-in. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. Leave both empty to hide the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Browser error reporting. Read at build time (the VITE_ prefix puts it in the client bundle). Empty means Sentry is off.
VITE_SENTRY_DSN=

# Base URL of the public Vercel Blob store that holds the paid animation clips (docs/deploy.md, Paid animation clips). Read at build time. Empty means the game uses the local apps/web/public/paid folder in dev and the free clips in production.
VITE_PAID_ASSETS_URL=

# ---- Local development and tests ----

# Who may open /owner (the observability page): comma separated sign-in emails or user ids. Unset means nobody.
OWNER_EMAILS=

# Set to 1 to enable the email and password dev sign-in. It is ignored when NODE_ENV is production.
DEV_LOGIN=

# Set to memory to run on a throwaway in-memory PGlite database (the e2e server and the smoke test do this).
DUELWISE_DB=

# Port for the dev server and Playwright. Empty means the port is chosen by the worktree folder name.
PORT=

# Set by Bun, Vite and Vercel (development, test or production). Do not set it by hand.
NODE_ENV=

# Folder holding the training supervisor's status.json for the agent stats page. Empty means <common root>/runs.
DUELWISE_RUNS_DIR=

# ---- Training (set by the supervisor for each job; never set by hand) ----

TRAINER_RUN_DIR=
TRAINER_CKPT_DIR=
TRAINER_HEARTBEAT=
# Optional overrides. Folder of exported human matches for the learn pipeline, and the Lichess download cache.
DUELWISE_HUMAN_ROOT=
CHESS_CACHE_DIR=

# ---- Measurement (set by packages/agents/src/measure/chess.ts after calibration; never set by hand) ----

CHESS_NODE_BUDGET=

# Dev and e2e only: set to "off" to skip the server agent-move check for random-move test opponents. Ignored in production builds.
DUELWISE_AGENT_CHECK=

# Test-only switch: set to 0 or 1 to pin the side the server gives a player in chess, Four in a Row and Crosscurrent (the e2e server uses it). Ignored in production builds.
DUELWISE_SIDE=

# Test-only switch for the dev page: the side a match with a fixed ?seed gets when the URL has no ?side (the e2e server sets it to 0). Dev builds only, ignored in production.
VITE_DUELWISE_SIDE=
